# GuardRail Environment Configuration

# Production Domains (Dokploy / Traefik)
API_DOMAIN=api.guardraill.xyz
FRONTEND_DOMAIN=guardraill.xyz
VITE_API_BASE_URL=https://api.guardraill.xyz/api/v1
VITE_FRONTEND_URL=https://guardraill.xyz
VITE_VPS_IP=

# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=False
DEBUG=False
SECRET_KEY=guardrail-super-secret-key-change-in-production-min-50-characters
ALLOWED_HOSTS=api.guardraill.xyz,guardraill.xyz,www.guardraill.xyz,web,localhost,127.0.0.1

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=guardrail_db
POSTGRES_USER=guardrail_user
POSTGRES_PASSWORD=guardrail_secret_pass_2026
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_HOST=db
DB_NAME=guardrail_db
DB_USER=guardrail_user
DB_PASSWORD=guardrail_secret_pass_2026
DB_PORT=5432

# Redis & Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Migration & Startup Controls
RUN_MIGRATIONS=true

# CORS & CSRF Trusted Origins
CORS_ALLOWED_ORIGINS=https://guardraill.xyz,https://www.guardraill.xyz,https://api.guardraill.xyz,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://guardraill.xyz,https://www.guardraill.xyz,https://api.guardraill.xyz

# Stellar Network Configuration
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# GuardRail Backend Co-Signer Keypair (Stored securely, never exposed to AI agents or clients)
GUARDRAIL_COSIGNER_PUBLIC_KEY=GAX4CIDATJTAG6GUU3UCD7IBFCTMI6EWKDWL5C5AHSS4PR3KHPLULZFT
GUARDRAIL_COSIGNER_SECRET_KEY=SCAPAHDZCHL7BWYT2MW47CZW7IYPGL7XXNUXEVPBXSPAFFJI7VDHNTGZ

# Soroban Smart Contract
SOROBAN_CONTRACT_ADDRESS=CDEMOGUARDRAILCONTRACTTESTNET1234567890ABCDEFGH
