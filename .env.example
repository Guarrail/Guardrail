# GuardRail Environment Configuration

# Django Settings
DEBUG=True
SECRET_KEY=guardrail-super-secret-key-change-in-production-min-50-characters
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# Database (PostgreSQL for Production / Docker, defaults to SQLite for local development if DB_NAME is not set)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=guardrail_db
DB_USER=guardrail_user
DB_PASSWORD=guardrail_secure_password
DB_HOST=db
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Stellar Network Configuration
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# GuardRail Backend Co-Signer Keypair (Stored securely, never exposed to AI agents or clients)
# Generate a new Testnet keypair or provide an existing one
GUARDRAIL_COSIGNER_PUBLIC_KEY=GBGUARDRAILCOSIGNERTESTNETPUBKEYDEMO1234567890ABCDEFGH
GUARDRAIL_COSIGNER_SECRET_KEY=SBGUARDRAILCOSIGNERTESTNETSECRETKEYDEMO1234567890ABCDEF

# Policy Defaults
PERMIT_EXPIRY_MINUTES=30
MAX_REQUEST_RATE_PER_MINUTE=60
