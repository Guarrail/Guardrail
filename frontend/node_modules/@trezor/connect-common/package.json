{
  "name": "@trezor/connect-common",
  "version": "10.0.0-beta.1",
  "type": "module",
  "author": "Trezor <info@trezor.io>",
  "homepage": "https://github.com/trezor/trezor-suite/tree/develop/packages/connect-common",
  "keywords": [
    "Trezor",
    "trezor-connect"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/trezor/trezor-suite.git"
  },
  "bugs": {
    "url": "https://github.com/trezor/trezor-suite/issues"
  },
  "license": "MIT",
  "description": "Collection of assets and utils used by trezor-connect library.",
  "main": "./lib/index.js",
  "files": [
    "lib/",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./lib/*": "./lib/*",
      "./lib/constants": {
        "types": "./lib/constants/index.d.ts",
        "default": "./lib/constants/index.js"
      },
      "./lib/data": {
        "types": "./lib/data/index.d.ts",
        "default": "./lib/data/index.js"
      },
      "./lib/events": {
        "types": "./lib/events/index.d.ts",
        "default": "./lib/events/index.js"
      },
      "./lib/types": {
        "types": "./lib/types/index.d.ts",
        "default": "./lib/types/index.js"
      }
    }
  },
  "scripts": {
    "build:lib": "yarn g:rimraf ./lib && yarn g:tsc --build tsconfig.lib.json && ../../scripts/publish/replace-imports.sh ./lib && DTS_OUT_DIR=lib yarn build:dts:inline",
    "build:dts:inline": "node ../../scripts/inline-devdep-types.mjs",
    "type-check": "yarn g:tsc --build tsconfig.json",
    "test:unit": "yarn g:jest",
    "depcheck": "yarn g:depcheck",
    "lint:js": "yarn g:eslint '**/*.{ts,tsx,js}'"
  },
  "dependencies": {
    "@trezor/crypto-utils": "10.0.0-beta.1",
    "@trezor/device-utils": "10.0.0-beta.1",
    "@trezor/protobuf": "10.0.0-beta.1",
    "@trezor/protocol": "^10.0.0-beta.1",
    "@trezor/schema-utils": "10.0.0-beta.1",
    "@trezor/type-utils": "10.0.0-beta.1",
    "@trezor/utils": "10.0.0-beta.1"
  },
  "peerDependencies": {
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@trezor/blockchain-link": "^10.0.0-beta.1",
    "@trezor/blockchain-link-types": "^10.0.0-beta.1",
    "@trezor/device-authenticity": "^10.0.0-beta.1",
    "@trezor/network-cardano": "10.0.0-beta.1",
    "@trezor/transport-common": "10.0.0-beta.1",
    "@trezor/utxo-lib": "10.0.0-beta.1",
    "@types/chrome": "^0.1.40",
    "@types/jest": "30.0.0",
    "@types/node": "22.13.10"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./lib/*": "./lib/*",
    "./lib/constants": {
      "types": "./lib/constants/index.d.ts",
      "default": "./lib/constants/index.js"
    },
    "./lib/data": {
      "types": "./lib/data/index.d.ts",
      "default": "./lib/data/index.js"
    },
    "./lib/events": {
      "types": "./lib/events/index.d.ts",
      "default": "./lib/events/index.js"
    },
    "./lib/types": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    }
  },
  "types": "./lib/index.d.ts"
}